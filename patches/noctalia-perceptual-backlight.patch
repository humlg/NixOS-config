+  // Backlight levels are linear luminance; the public value is CIE L* (perceived lightness), 0..1.
+  float backlightToPerceived(float linear) {
+    linear = std::clamp(linear, 0.0F, 1.0F);
+    const float lightness = linear <= 0.008856F ? 903.3F * linear : 116.0F * std::cbrt(linear) - 16.0F;
+    return std::clamp(lightness / 100.0F, 0.0F, 1.0F);
+  }
+
+  float backlightToLinear(float perceived) {
+    const float lightness = std::clamp(perceived, 0.0F, 1.0F) * 100.0F;
+    const float linear = lightness <= 8.0F ? lightness / 903.3F : std::pow((lightness + 16.0F) / 116.0F, 3.0F);
+    return std::clamp(linear, 0.0F, 1.0F);
+  }
